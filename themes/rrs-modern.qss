/* ===========================================================================
   RRS launcher - modern dark theme with red accent
   Tokens:
     bg       #0E1014      surface  #15181E      input   #12151A
     border   #262B34      strong   #333A46      text    #E6E9EF
     dim      #98A2B3      accent   #E2231A      hover   #F03B30
   =========================================================================== */

QWidget
{
    background-color: #0E1014;
    color: #E6E9EF;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QLabel,
QCheckBox
{
    background: transparent;
}

/* ---- header ------------------------------------------------------------ */

#headerBar
{
    background-color: #15181E;
    border-bottom: 1px solid #23272F;
}

#lblLogo
{
    background: transparent;
    border: none;
    border-radius: 10px;
}

#lblTitle
{
    color: #FFFFFF;
    font-size: 16pt;
    font-weight: 600;
}

#lblSubtitle
{
    color: #8C97A8;
    font-size: 9.5pt;
    letter-spacing: 1px;
}

/* ---- tabs -------------------------------------------------------------- */

QTabWidget::pane
{
    border: none;
    background: transparent;
}

QTabBar
{
    background: transparent;
}

QTabBar::tab
{
    background: transparent;
    color: #98A2B3;
    padding: 9px 22px;
    margin-right: 6px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 11pt;
}

QTabBar::tab:hover:!selected
{
    color: #E6E9EF;
}

QTabBar::tab:selected
{
    color: #FFFFFF;
    border-bottom: 2px solid #E2231A;
}

/* ---- cards / group boxes ----------------------------------------------- */

QGroupBox
{
    background-color: #15181E;
    border: 1px solid #23272F;
    border-radius: 10px;
    font-weight: 600;
    color: #C9D1DC;
}

QGroupBox::title
{
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    top: 5px;
    padding: 0 4px;
    background: transparent;
    color: #C9D1DC;
}

QLabel[role="caption"]
{
    color: #8C97A8;
    font-size: 9pt;
    font-weight: 600;
}

QLabel[role="dot"]
{
    color: #8C97A8;
    font-size: 13pt;
    font-weight: 700;
    padding-bottom: 2px;
}

#frame
{
    background: transparent;
    border: none;
}

/* ---- lists ------------------------------------------------------------- */

QListWidget
{
    background-color: #12151A;
    border: 1px solid #262B34;
    border-radius: 8px;
    padding: 4px;
    outline: 0;
}

QListWidget::item
{
    padding: 7px 10px;
    border-radius: 6px;
    margin: 1px 2px;
}

QListWidget::item:hover:!selected
{
    background-color: #1A1F27;
}

QListWidget::item:selected
{
    background-color: #E2231A;
    color: #FFFFFF;
}

/* ---- text areas -------------------------------------------------------- */

QPlainTextEdit,
QTextEdit,
QTextBrowser
{
    background-color: #12151A;
    border: 1px solid #262B34;
    border-radius: 8px;
    padding: 6px;
    color: #C9D1DC;
    selection-background-color: #E2231A;
    selection-color: #FFFFFF;
}

#tbLogGPU
{
    background-color: #0A0C10;
    border: 1px solid #23272F;
    border-radius: 8px;
    padding: 6px 8px;
    color: #B9C2D0;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 9pt;
}

/* ---- buttons ----------------------------------------------------------- */

QPushButton
{
    background-color: #222833;
    color: #E6E9EF;
    border: 1px solid #333A46;
    border-radius: 8px;
    padding: 8px 16px;
    min-height: 18px;
}

QPushButton:hover
{
    background-color: #2A3140;
    border-color: #414A59;
}

QPushButton:pressed
{
    background-color: #1A2029;
}

QPushButton:focus
{
    outline: none;
    border-color: #E2231A;
}

QPushButton:disabled
{
    background-color: #171A20;
    color: #5C6472;
    border-color: #232831;
}

QPushButton[compact="true"]
{
    padding: 6px 14px;
    min-height: 16px;
}

QPushButton[primary="true"]
{
    background-color: #E2231A;
    border-color: #E2231A;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton[primary="true"]:hover
{
    background-color: #F03B30;
    border-color: #F03B30;
}

QPushButton[primary="true"]:pressed
{
    background-color: #B71C1C;
    border-color: #B71C1C;
}

QPushButton[primary="true"]:disabled
{
    background-color: #1B1F26;
    border-color: #262B34;
    color: #5C6472;
}

QPushButton[state="stop"]
{
    background-color: #B71C1C;
    border-color: #B71C1C;
    color: #FFFFFF;
}

QPushButton[state="stop"]:hover
{
    background-color: #C62828;
    border-color: #C62828;
}

/* ---- check boxes ------------------------------------------------------- */

QCheckBox
{
    spacing: 8px;
}

QCheckBox:disabled
{
    color: #5C6472;
}

QCheckBox::indicator
{
    width: 16px;
    height: 16px;
    border: 1px solid #39404C;
    border-radius: 4px;
    background-color: #12151A;
}

QCheckBox::indicator:hover
{
    border-color: #E2231A;
}

QCheckBox::indicator:checked
{
    background-color: #E2231A;
    border-color: #E2231A;
    image: url(:/images/images/check.png);
}

QCheckBox::indicator:checked:hover
{
    background-color: #F03B30;
    border-color: #F03B30;
}

QCheckBox::indicator:disabled
{
    border-color: #232831;
    background-color: #171A20;
}

/* ---- sliders ----------------------------------------------------------- */

QSlider
{
    background: transparent;
    min-height: 20px;
}

QSlider::groove:horizontal
{
    height: 4px;
    background-color: #2A3039;
    border-radius: 2px;
}

QSlider::sub-page:horizontal
{
    background-color: #E2231A;
    border-radius: 2px;
}

QSlider::add-page:horizontal
{
    background-color: #2A3039;
    border-radius: 2px;
}

QSlider::handle:horizontal
{
    width: 14px;
    height: 14px;
    margin: -7px 0;
    border: 2px solid #E2231A;
    border-radius: 9px;
    background-color: #E6E9EF;
}

QSlider::handle:horizontal:hover
{
    background-color: #FFFFFF;
    border-color: #F03B30;
}

QSlider::handle:horizontal:disabled
{
    background-color: #5C6472;
    border-color: #39404C;
}

QSlider::sub-page:horizontal:disabled
{
    background-color: #39404C;
}

QSlider::add-page:horizontal:disabled
{
    background-color: #232831;
}

/* ---- inputs ------------------------------------------------------------ */

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit
{
    background-color: #12151A;
    border: 1px solid #333A46;
    border-radius: 6px;
    padding: 5px 8px;
    min-height: 20px;
    color: #E6E9EF;
    selection-background-color: #E2231A;
    selection-color: #FFFFFF;
}

QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateEdit:hover,
QTimeEdit:hover,
QDateTimeEdit:hover
{
    border-color: #414A59;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QDateTimeEdit:focus
{
    border-color: #E2231A;
}

QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateEdit:disabled,
QTimeEdit:disabled,
QDateTimeEdit:disabled
{
    background-color: #171A20;
    color: #5C6472;
    border-color: #232831;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QDateEdit::up-button,
QTimeEdit::up-button,
QDateTimeEdit::up-button
{
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    border: none;
    background: transparent;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button,
QDateEdit::down-button,
QTimeEdit::down-button,
QDateTimeEdit::down-button
{
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    border: none;
    background: transparent;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow,
QDateEdit::up-arrow,
QTimeEdit::up-arrow,
QDateTimeEdit::up-arrow
{
    image: url(:/images/images/arrow-up.png);
    width: 9px;
    height: 9px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow,
QDateEdit::down-arrow,
QTimeEdit::down-arrow,
QDateTimeEdit::down-arrow
{
    image: url(:/images/images/arrow-down.png);
    width: 9px;
    height: 9px;
}

/* ---- combo boxes ------------------------------------------------------- */

QComboBox
{
    background-color: #12151A;
    border: 1px solid #333A46;
    border-radius: 6px;
    padding: 5px 28px 5px 10px;
    min-height: 20px;
    color: #E6E9EF;
}

QComboBox:hover
{
    border-color: #414A59;
}

QComboBox:focus
{
    border-color: #E2231A;
}

QComboBox:disabled
{
    background-color: #171A20;
    color: #5C6472;
    border-color: #232831;
}

QComboBox::drop-down
{
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 22px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow
{
    image: url(:/images/images/arrow-down.png);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView
{
    background-color: #171B21;
    border: 1px solid #333A46;
    border-radius: 6px;
    padding: 4px;
    outline: 0;
    selection-background-color: #E2231A;
    selection-color: #FFFFFF;
}

/* ---- tool box (active trains) ------------------------------------------ */

QToolBox
{
    background: transparent;
    border: none;
}

QToolBox::tab
{
    background-color: #171B21;
    border: 1px solid #262B34;
    border-radius: 6px;
    color: #C9D1DC;
    padding: 6px 10px;
    margin-bottom: 4px;
}

QToolBox::tab:selected
{
    background-color: #1E2229;
    border-left: 3px solid #E2231A;
    color: #FFFFFF;
}

/* ---- menus ------------------------------------------------------------- */

QMenuBar
{
    background-color: #15181E;
    border-bottom: 1px solid #23272F;
    padding: 2px 6px;
}

QMenuBar::item
{
    background: transparent;
    padding: 5px 12px;
    border-radius: 6px;
}

QMenuBar::item:selected
{
    background-color: #222833;
}

QMenu
{
    background-color: #171B21;
    border: 1px solid #333A46;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item
{
    background: transparent;
    padding: 7px 26px 7px 14px;
    border-radius: 6px;
    color: #E6E9EF;
}

QMenu::item:selected
{
    background-color: #E2231A;
    color: #FFFFFF;
}

QMenu::separator
{
    height: 1px;
    background-color: #2A2F39;
    margin: 6px 8px;
}

/* ---- scroll bars ------------------------------------------------------- */

QScrollBar:vertical
{
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical
{
    background-color: #39404C;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover
{
    background-color: #4A5262;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical
{
    height: 0;
    background: transparent;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical
{
    background: transparent;
}

QScrollBar:horizontal
{
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal
{
    background-color: #39404C;
    border-radius: 5px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover
{
    background-color: #4A5262;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal
{
    width: 0;
    background: transparent;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal
{
    background: transparent;
}

/* ---- misc -------------------------------------------------------------- */

QToolTip
{
    background-color: #171B21;
    color: #E6E9EF;
    border: 1px solid #333A46;
    border-radius: 6px;
    padding: 6px 8px;
}

QStatusBar
{
    background-color: #15181E;
    color: #98A2B3;
}
